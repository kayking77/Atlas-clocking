{
  "expo": {
    "name": "Atlas Timeclock",
    "slug": "atlas-timeclock",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.atlasstaffing.timeclock",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Atlas Timeclock records your location only at the moment you clock in or clock out, to confirm which house you are working at."
      }
    },
    "android": {
      "package": "com.atlasstaffing.timeclock",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Atlas Timeclock records your location only at the moment you clock in or clock out, to confirm which house you are working at.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
